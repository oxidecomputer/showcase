# Claude self-hosted environment key.
SELF_HOSTED_RUNNER_ENVIRONMENT_SECRET=sk-ant-cc-abc123

# Oxide credentials.
OXIDE_HOST=https://oxide.sys.example.com
OXIDE_TOKEN=oxide-token-abc123

# Runner placement. IMAGE_ID is the runner image built from runner/.
PROJECT=my-project
IMAGE_ID=00000000-0000-0000-0000-000000000000
VPC_NAME=default
SUBNET_NAME=default

# Runner resources.
NCPUS=2
MEMORY_GIB=8
DISK_GIB=32

# Optional: set these to enable SSH access to runners for debugging.
SSH_KEY_ID=
IP_POOL=

# Maximum number of active runners.
MAX_RUNNERS=10

# Claude Code version installed on the orchestrator. Build the runner image with
# the same claude_version.
CLAUDE_VERSION=2.1.312

# Runner lifecycle. The spawn-runner hook passes these values to the Claude
# runner process inside each instance.
# Exit if the runner never receives a session.
EXIT_IF_UNUSED_MIN=10
# Release a session after this much user inactivity.
RELEASE_IDLE_MIN=30
# Limit the total lifetime of a session process.
KILL_SESSION_AFTER_MIN=480
