# Oxide credentials file profile.
OXIDE_PROFILE=my-profile

# Instance placement.
PROJECT=my-project
IMAGE_ID=00000000-0000-0000-0000-000000000000
VPC_NAME=default
SUBNET_NAME=default

# Runner resources.
NCPUS=2
MEMORY_GIB=8
DISK_GIB=32

# Optional: set these to enable SSH access to runners for debugging.
SSH_KEY_ID=
IP_POOL=

# Maximum number of active runners.
MAX_RUNNERS=10

# Claude Code version. Ensure the orchestrator and runner use the same version.
CLAUDE_VERSION=2.1.267

# Runner lifecycle. The spawn-runner hook passes these values to the Claude
# runner process inside each instance.
# Exit if the runner never receives a session.
EXIT_IF_UNUSED_MIN=10
# Release a session after this much user inactivity.
RELEASE_IDLE_MIN=30
# Limit the total lifetime of a session process.
KILL_SESSION_AFTER_MIN=480
