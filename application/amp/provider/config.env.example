# Orb provider token from Settings → Orbs → Add Orb Provider.
AMP_ORB_PROVIDER_TOKEN=aop_live_abc123

# Orb image built from orb/. Amp passes it to every spawn job.
ORB_IMAGE=amp-orb-2026-01-01-000000

# Oxide credentials.
OXIDE_HOST=https://oxide.sys.example.com
OXIDE_TOKEN=oxide-token-abc123

# Project for orb instances and disks. ORB_IMAGE is looked up here first, then
# in the silo.
OXIDE_ORB_PROJECT=my-project

# IP pool for each orb's ephemeral external IP, which gives it outbound
# internet access.
OXIDE_ORB_IP_POOL=public

# Orb resources. The disk must be at least as large as the orb image.
OXIDE_ORB_NCPUS=4
OXIDE_ORB_MEMORY_GIB=8
OXIDE_ORB_DISK_GIB=20
